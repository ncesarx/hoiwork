generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  auditLogs     AuditLog[]
  memberships   Membership[]
  sessions      Session[]
  ticketsOwned  Ticket[]     @relation("TicketAssignedTo")
  ticketsOpened Ticket[]     @relation("TicketOpenedBy")
  discoveryRuns       DiscoveryRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  cns                  String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assets               Asset[]
  auditLogs            AuditLog[]
  backupJobs           BackupJob[]
  contracts            Contract[]
  drPlan               DisasterRecoveryPlan?
  documents            Document[]
  integrations         Integration[]
  integrationResources IntegrationResource[]
  memberships          Membership[]
  tickets              Ticket[]
  infrastructureAssets InfrastructureAsset[]
  discoveryRuns       DiscoveryRun[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(CLIENT)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Asset {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           String
  manufacturer   String?
  model          String?
  serialNumber   String?
  ipAddress      String?
  location       String?
  warrantyEndsAt DateTime?
  status         String       @default("ONLINE")
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  openedById     String
  assignedToId   String?
  title          String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignedTo     User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  openedBy       User           @relation("TicketOpenedBy", fields: [openedById], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  category       String
  storageKey     String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
}

model Contract {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  status         String       @default("ACTIVE")
  startsAt       DateTime
  endsAt         DateTime
  slaHours       Int?
  monthlyHours   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model BackupJob {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           String
  status         String       @default("PENDING")
  progress       Int          @default(0)
  retentionDays  Int?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model DisasterRecoveryPlan {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  primarySite       String
  recoverySite      String
  primaryStatus     String       @default("OPERATIONAL")
  recoveryStatus    String       @default("READY")
  replicationStatus String       @default("SYNCHRONIZED")
  lastSyncAt        DateTime?
  rpoMinutes        Int
  rtoMinutes        Int
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id             String                @id @default(cuid())
  organizationId String
  provider       String
  name           String
  enabled        Boolean               @default(true)
  mode           String                @default("LIVE")
  status         String                @default("PENDING")
  config         Json?
  lastSyncAt     DateTime?
  lastHealthAt   DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      IntegrationResource[]
  syncRuns       IntegrationSyncRun[]

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  infrastructureAssets InfrastructureAsset[]
  discoveryRuns       DiscoveryRun[]
}

model IntegrationResource {
  id               String       @id @default(cuid())
  organizationId   String
  integrationId    String
  externalId       String
  kind             String
  name             String
  status           String
  node             String?
  cpuPercent       Float?
  memoryUsedBytes  BigInt?
  memoryTotalBytes BigInt?
  diskUsedBytes    BigInt?
  diskTotalBytes   BigInt?
  uptimeSeconds    BigInt?
  metadata         Json?
  lastSeenAt       DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  integration      Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([organizationId, kind, status])
}

model IntegrationSyncRun {
  id                String      @id @default(cuid())
  integrationId     String
  status            String
  startedAt         DateTime
  completedAt       DateTime?
  discoveredCount   Int         @default(0)
  synchronizedCount Int         @default(0)
  errorMessage      String?
  integration       Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
}

enum MembershipRole {
  CLIENT
  MANAGER
  TECHNICIAN
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model InfrastructureAsset {
  id               String       @id @default(cuid())
  organizationId   String
  integrationId    String?
  externalId       String
  provider         String
  assetType        String
  name             String
  clusterName      String?
  parentExternalId String?
  nodeName         String?
  status           String
  ipAddress        String?
  cpuPercent       Float?
  cpuCores         Int?
  memoryUsedBytes  BigInt?
  memoryTotalBytes BigInt?
  diskUsedBytes    BigInt?
  diskTotalBytes   BigInt?
  uptimeSeconds    BigInt?
  version          String?
  metadata         Json?
  firstSeenAt      DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  lastChangedAt    DateTime     @default(now())
  active           Boolean      @default(true)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration      Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, assetType, status])
  @@index([integrationId, lastSeenAt])
}

model DiscoveryRun {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String?
  userId         String?
  provider       String
  scope          String
  status         String       @default("RUNNING")
  endpoint       String?
  version        String?
  clusterName    String?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  durationMs     Int?
  discovered     Int          @default(0)
  createdCount   Int          @default(0)
  updatedCount   Int          @default(0)
  unchangedCount Int          @default(0)
  offlineCount   Int          @default(0)
  errorMessage   String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs           DiscoveryLog[]

  @@index([organizationId, startedAt])
  @@index([integrationId, startedAt])
}

model DiscoveryLog {
  id        String       @id @default(cuid())
  runId     String
  step      String
  level     String       @default("INFO")
  message   String
  durationMs Int?
  metadata  Json?
  createdAt DateTime     @default(now())
  run       DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}
